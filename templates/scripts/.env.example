# Kopieren nach scripts/.env (ist in .gitignore, wird nie committed).
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=

# Optional
# SONAR_ORGANIZATION=<sonarcloud-organisation>   # Default: sonar-project.properties
# SONAR_PROJECT_KEY=<projekt-key>                # Default: sonar-project.properties, sonst Ordnername
# SONAR_EXCLUSIONS=**/node_modules/**,**/dist/**
